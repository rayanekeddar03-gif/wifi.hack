<script>

/* تغيير الصفحة */
function showPage(id){

    const pages = document.querySelectorAll(".page");

    pages.forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById(id).classList.add("active");
}


/* الصفحة الرئيسية */
function goHome(){

    showPage("page1");

}


/* قائمة الشبكات */
function openNetworks(){

    document.getElementById("errorBox").style.display = "none";

    showPage("page2");

}


/* رسالة الشبكات غير القابلة للمحاكاة */
function showError(networkName){

    const box = document.getElementById("errorBox");

    box.innerHTML =
        "⚠️ You can't hack this Wi-Fi<br><small>" +
        networkName +
        "</small>";

    box.style.display = "block";

    setTimeout(() => {

        box.style.display = "none";

    },3000);

}


/* بدء المحاكاة */
function startHack(network, success){

    if(!success) return;

    showPage("process");

    const target =
        document.getElementById("target");

    const terminal =
        document.getElementById("terminal");

    const progress =
        document.getElementById("progress");

    const percent =
        document.getElementById("percent");

    const status =
        document.getElementById("status");

    const resultNetwork =
        document.getElementById("resultNetwork");


    target.textContent = network;

    terminal.innerHTML =
        "> Initializing simulator...";

    progress.style.width = "0%";

    percent.textContent = "0%";

    status.textContent =
        "Starting simulation...";


    const logs = [

        "> Scanning simulated channels...",

        "> Analyzing signal strength...",

        "> Simulating WPA2 handshake...",

        "> Processing simulated hash...",

        "> Running password simulation...",

        "> Simulation complete!"

    ];


    let currentLog = 0;

    let value = 0;


    const interval = setInterval(() => {

        value += 10;

        if(value > 100){
            value = 100;
        }


        progress.style.width =
            value + "%";

        percent.textContent =
            value + "%";


        if(currentLog < logs.length){

            terminal.innerHTML +=
                "<br>" +
                logs[currentLog];

            terminal.scrollTop =
                terminal.scrollHeight;

            currentLog++;

        }


        if(value < 100){

            status.textContent =
                "Simulation in progress...";

        }else{

            status.textContent =
                "Finished ✓";

        }


        if(value >= 100){

            clearInterval(interval);


            setTimeout(() => {

                resultNetwork.textContent =
                    network;

                showPage("result");

            },900);

        }

    },450);

}

</script>

</body>
